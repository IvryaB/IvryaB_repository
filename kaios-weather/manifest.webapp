{
  "version": "1.1.0",
  "name": "Погода",
  "description": "Погода сейчас, по часам и на неделю (Open-Meteo или AccuWeather). Управление кнопками.",
  "launch_path": "/index.html",
  "type": "privileged",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png"
  },
  "developer": {
    "name": "IvryaB"
  },
  "default_locale": "ru",
  "locales": {
    "ru": {
      "name": "Погода",
      "subtitle": "Прогноз погоды",
      "description": "Погода сейчас, по часам и на неделю."
    },
    "uk": {
      "name": "Погода",
      "subtitle": "Прогноз погоды",
      "description": "Погода зараз, погодинно та на тиждень."
    },
    "en-US": {
      "name": "Weather",
      "subtitle": "Weather forecast",
      "description": "Weather now, hourly and for the week."
    }
  },
  "permissions": {
    "systemXHR": {
      "description": "Загрузка погоды (Open-Meteo, AccuWeather) и названий мест"
    },
    "geolocation": {
      "description": "Погода для текущего местоположения"
    }
  },
  "orientation": "portrait",
  "cursor": false,
  "fullscreen": false,
  "theme_color": "#1b3f6e"
}
