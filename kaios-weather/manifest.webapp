{
  "version": "1.2.0",
  "name": "Погода",
  "description": "Погода сейчас, по часам и на неделю (Open-Meteo), уведомления по расписанию. Управление кнопками.",
  "launch_path": "/index.html",
  "type": "privileged",
  "icons": {
    "56": "/icons/icon-56.png",
    "112": "/icons/icon-112.png"
  },
  "developer": {
    "name": "IvryaB"
  },
  "default_locale": "ru",
  "locales": {
    "ru": {
      "name": "Погода",
      "subtitle": "Прогноз погоды",
      "description": "Погода сейчас, по часам и на неделю, уведомления по расписанию."
    },
    "uk": {
      "name": "Погода",
      "subtitle": "Прогноз погоды",
      "description": "Погода зараз, погодинно та на тиждень, сповіщення за розкладом."
    },
    "en-US": {
      "name": "Weather",
      "subtitle": "Weather forecast",
      "description": "Weather now, hourly and for the week, with scheduled notifications."
    }
  },
  "permissions": {
    "systemXHR": {
      "description": "Загрузка погоды (Open-Meteo) и названий мест (OpenStreetMap)"
    },
    "geolocation": {
      "description": "Погода для текущего местоположения"
    },
    "alarms": {
      "description": "Уведомления о погоде по расписанию"
    },
    "desktop-notification": {
      "description": "Уведомления о погоде"
    }
  },
  "orientation": "portrait",
  "cursor": false,
  "fullscreen": false,
  "theme_color": "#1b3f6e",
  "messages": [
    {
      "alarm": "/index.html"
    },
    {
      "notification": "/index.html"
    }
  ]
}
