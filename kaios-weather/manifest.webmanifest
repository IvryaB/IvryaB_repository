{
  "name": "Погода",
  "short_name": "Погода",
  "description": "Погода от AccuWeather: сейчас, по часам и на 5 дней. Управление кнопками.",
  "lang": "ru",
  "start_url": "/index.html",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#1b3f6e",
  "background_color": "#121821",
  "icons": [
    { "src": "/icons/icon-56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/icons/icon-112.png", "type": "image/png", "sizes": "112x112" }
  ],
  "b2g_features": {
    "version": "1.0.0",
    "developer": { "name": "IvryaB" },
    "type": "privileged",
    "permissions": {
      "systemXHR": { "description": "Загрузка погоды с серверов AccuWeather" },
      "geolocation": { "description": "Погода для текущего местоположения" }
    },
    "locales": {
      "en-US": { "name": "Weather", "description": "AccuWeather forecast: now, hourly and 5 days." }
    },
    "default_locale": "ru"
  }
}
